rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Primitive Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn()
        && (
          ('email_verified' in request.auth.token && request.auth.token.email_verified == true)
          || ('firebase' in request.auth.token
              && 'sign_in_provider' in request.auth.token.firebase
              && request.auth.token.firebase.sign_in_provider == 'password')
        );
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidStage(stage) {
      return stage in [
        'novo_lead',
        'primeiro_contato',
        'aguardando_retorno',
        'contato_estabelecido',
        'reuniao_agendada',
        'reuniao_realizada',
        'proposta_enviada',
        'em_negociacao',
        'venda_fechada',
        'perdido'
      ];
    }

    function isValidOptionalStage(stage) {
      return stage == '' || isValidStage(stage);
    }

    function isValidPotential(potential) {
      return potential in ['', 'baixo', 'medio', 'alto'];
    }

    function isValidInterest(level) {
      return level in ['', 'frio', 'morno', 'quente', 'muito_quente'];
    }

    function isValidChannel(channel) {
      return channel in ['whatsapp', 'ligacao', 'email', 'reuniao', 'outro'];
    }

    function isValidInteractionType(t) {
      return t in [
        'primeiro_contato',
        'follow_up',
        'qualificacao',
        'reuniao',
        'apresentacao_proposta',
        'negociacao',
        'pos_venda',
        'outro'
      ];
    }

    // --- Entity Validation Blueprints (synchronized with firebase-blueprint.json) ---
    function isValidWorkspace(data, workspaceId) {
      return data.keys().hasAll([
          'ownerId', 'ownerEmail', 'name', 'caioBaseImported',
          'caioBaseImportedAt', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'ownerEmail', 'name', 'caioBaseImported',
          'caioBaseImportedAt', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.ownerId == workspaceId
        && data.ownerEmail is string && data.ownerEmail.size() <= 254
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.caioBaseImported is bool
        && data.caioBaseImportedAt is string && data.caioBaseImportedAt.size() <= 40
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidLead(data, workspaceId) {
      return data.keys().hasAll([
          'ownerId', 'workspaceId', 'fullName', 'company', 'phone', 'email',
          'city', 'segment', 'source', 'importedFromCaioSheet', 'entryDate',
          'ownerName', 'stage', 'potential', 'estimatedValue', 'notes',
          'meetingDate', 'interestLevel', 'nextAction', 'nextFollowUpDate',
          'lastContactAt', 'lastInteractionSummary', 'interactionCount',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'workspaceId', 'fullName', 'company', 'phone', 'email',
          'city', 'segment', 'source', 'importedFromCaioSheet', 'entryDate',
          'ownerName', 'stage', 'potential', 'estimatedValue', 'notes',
          'meetingDate', 'interestLevel', 'nextAction', 'nextFollowUpDate',
          'lastContactAt', 'lastInteractionSummary', 'interactionCount',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && isValidId(data.workspaceId)
        && data.workspaceId == workspaceId
        && data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 160
        && data.company is string && data.company.size() >= 1 && data.company.size() <= 200
        && data.phone is string && data.phone.size() <= 40
        && data.email is string && data.email.size() <= 254
        && data.city is string && data.city.size() <= 120
        && data.segment is string && data.segment.size() <= 300
        && data.source is string && data.source.size() >= 1 && data.source.size() <= 160
        && data.importedFromCaioSheet is bool
        && data.entryDate is string && data.entryDate.size() <= 20
        && data.ownerName is string && data.ownerName.size() <= 120
        && data.stage is string && isValidStage(data.stage)
        && data.potential is string && isValidPotential(data.potential)
        && (data.estimatedValue == null || (data.estimatedValue is number && data.estimatedValue >= 0 && data.estimatedValue <= 1000000000))
        && data.notes is string && data.notes.size() <= 4000
        && data.meetingDate is string && data.meetingDate.size() <= 40
        && data.interestLevel is string && isValidInterest(data.interestLevel)
        && data.nextAction is string && data.nextAction.size() <= 500
        && data.nextFollowUpDate is string && data.nextFollowUpDate.size() <= 20
        && data.lastContactAt is string && data.lastContactAt.size() <= 40
        && data.lastInteractionSummary is string && data.lastInteractionSummary.size() <= 500
        && data.interactionCount is int && data.interactionCount >= 0 && data.interactionCount <= 100000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidInteraction(data, workspaceId, leadId) {
      return data.keys().hasAll([
          'ownerId', 'workspaceId', 'leadId', 'contactedAt', 'channel',
          'interactionType', 'summary', 'clientResponse', 'interestLevel',
          'needsIdentified', 'objections', 'nextAction', 'nextFollowUpDate',
          'stageAfter', 'createdAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'workspaceId', 'leadId', 'contactedAt', 'channel',
          'interactionType', 'summary', 'clientResponse', 'interestLevel',
          'needsIdentified', 'objections', 'nextAction', 'nextFollowUpDate',
          'stageAfter', 'createdAt'
        ])
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && isValidId(data.workspaceId)
        && data.workspaceId == workspaceId
        && isValidId(data.leadId)
        && data.leadId == leadId
        && data.contactedAt is string && data.contactedAt.size() >= 1 && data.contactedAt.size() <= 40
        && data.channel is string && isValidChannel(data.channel)
        && data.interactionType is string && isValidInteractionType(data.interactionType)
        && data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 3000
        && data.clientResponse is string && data.clientResponse.size() <= 3000
        && data.interestLevel is string && isValidInterest(data.interestLevel)
        && data.needsIdentified is string && data.needsIdentified.size() <= 2000
        && data.objections is string && data.objections.size() <= 2000
        && data.nextAction is string && data.nextAction.size() <= 500
        && data.nextFollowUpDate is string && data.nextFollowUpDate.size() <= 20
        && data.stageAfter is string && isValidOptionalStage(data.stageAfter)
        && data.createdAt is timestamp;
    }

    // --- Relational Master Gate Helpers ---
    function isWorkspaceOwner(workspaceId) {
      return exists(/databases/$(database)/documents/workspaces/$(workspaceId))
        && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId == request.auth.uid;
    }

    function isLeadOwner(workspaceId, leadId) {
      return exists(/databases/$(database)/documents/workspaces/$(workspaceId)/leads/$(leadId))
        && get(/databases/$(database)/documents/workspaces/$(workspaceId)/leads/$(leadId)).data.ownerId == request.auth.uid;
    }

    // --- Collection: Workspaces ---
    match /workspaces/{workspaceId} {
      allow get: if isVerifiedUser()
        && isValidId(workspaceId)
        && workspaceId == request.auth.uid;

      allow list: if false;

      allow create: if isVerifiedUser()
        && isValidId(workspaceId)
        && workspaceId == request.auth.uid
        && isValidWorkspace(incoming(), workspaceId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(workspaceId)
        && workspaceId == request.auth.uid
        && isValidWorkspace(incoming(), workspaceId)
        && existing().ownerId == request.auth.uid
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action: Update workspace metadata or import flag
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'caioBaseImported', 'caioBaseImportedAt', 'updatedAt'])
        );

      allow delete: if false;

      // --- Subcollection: Leads ---
      match /leads/{leadId} {
        allow get: if isVerifiedUser()
          && isValidId(workspaceId)
          && isValidId(leadId)
          && workspaceId == request.auth.uid
          && existing().ownerId == request.auth.uid
          && isWorkspaceOwner(workspaceId);

        // Secure list query enforced directly on resource.data without get() calls
        allow list: if isVerifiedUser()
          && workspaceId == request.auth.uid
          && resource.data.ownerId == request.auth.uid
          && resource.data.workspaceId == workspaceId;

        allow create: if isVerifiedUser()
          && isValidId(workspaceId)
          && isValidId(leadId)
          && workspaceId == request.auth.uid
          && isValidLead(incoming(), workspaceId)
          && incoming().interactionCount == 0
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && isWorkspaceOwner(workspaceId);

        allow update: if isVerifiedUser()
          && isValidId(workspaceId)
          && isValidId(leadId)
          && workspaceId == request.auth.uid
          && isValidLead(incoming(), workspaceId)
          && existing().ownerId == request.auth.uid
          && incoming().ownerId == existing().ownerId
          && incoming().workspaceId == existing().workspaceId
          && incoming().importedFromCaioSheet == existing().importedFromCaioSheet
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && isWorkspaceOwner(workspaceId)
          && (
            // Action 1: Quick funnel stage move
            (
              incoming().diff(existing()).affectedKeys().hasOnly(['stage', 'updatedAt'])
            ) ||
            // Action 2: Edit lead profile & opportunity details
            (
              incoming().diff(existing()).affectedKeys().hasOnly([
                'fullName', 'company', 'phone', 'email', 'city', 'segment',
                'source', 'entryDate', 'ownerName', 'stage', 'potential',
                'estimatedValue', 'notes', 'meetingDate', 'interestLevel',
                'nextAction', 'nextFollowUpDate', 'updatedAt'
              ])
            ) ||
            // Action 3: Atomic sync when logging a new interaction
            (
              incoming().diff(existing()).affectedKeys().hasOnly([
                'stage', 'interestLevel', 'nextAction', 'nextFollowUpDate',
                'lastContactAt', 'lastInteractionSummary', 'interactionCount',
                'meetingDate', 'updatedAt'
              ])
              && incoming().interactionCount == existing().interactionCount + 1
            )
          );

        allow delete: if isVerifiedUser()
          && isValidId(workspaceId)
          && isValidId(leadId)
          && workspaceId == request.auth.uid
          && existing().ownerId == request.auth.uid
          && isWorkspaceOwner(workspaceId);

        // --- Subcollection: Interactions (Append-only history) ---
        match /interactions/{interactionId} {
          allow get: if isVerifiedUser()
            && isValidId(workspaceId)
            && isValidId(leadId)
            && isValidId(interactionId)
            && workspaceId == request.auth.uid
            && existing().ownerId == request.auth.uid
            && isLeadOwner(workspaceId, leadId);

          // Secure list query enforced directly on resource.data
          allow list: if isVerifiedUser()
            && workspaceId == request.auth.uid
            && resource.data.ownerId == request.auth.uid
            && resource.data.workspaceId == workspaceId
            && resource.data.leadId == leadId;

          // Atomicity guarantee: parent lead interactionCount must increment in the same batch
          allow create: if isVerifiedUser()
            && isValidId(workspaceId)
            && isValidId(leadId)
            && isValidId(interactionId)
            && workspaceId == request.auth.uid
            && isValidInteraction(incoming(), workspaceId, leadId)
            && incoming().createdAt == request.time
            && isWorkspaceOwner(workspaceId)
            && isLeadOwner(workspaceId, leadId)
            && getAfter(/databases/$(database)/documents/workspaces/$(workspaceId)/leads/$(leadId)).data.interactionCount
               == get(/databases/$(database)/documents/workspaces/$(workspaceId)/leads/$(leadId)).data.interactionCount + 1;

          // Strictly append-only history: never overwrite or delete logged interactions
          allow update, delete: if false;
        }
      }
    }
  }
}
